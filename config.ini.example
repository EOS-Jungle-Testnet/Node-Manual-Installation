# EOS Jungle4 Testnet Config file (AntelopeIO Spring v1.2.2)
# https://github.com/EOS-Jungle-Testnet/Node-Manual-Installation
# https://github.com/CryptoLions


    producer-name = YOUR_BP_NAME
    signature-provider = YOUR_PUB_KEY_HERE=KEY:YOUR_PRIV_KEY_HERE
    # Savanna finalizer (BLS) key, required for BPs - see README "Register finalizer key"
    signature-provider = YOUR_PUB_BLS_KEY_HERE=KEY:YOUR_PRIV_BLS_KEY_HERE

    http-server-address = 0.0.0.0:8888
    p2p-listen-endpoint = 0.0.0.0:9876
    p2p-server-address = YOUR_NODE_EXTERNAL_IP_ADDRESS:9876
    
    chain-state-db-size-mb = 16384
    
    contracts-console = true
    
    p2p-max-nodes-per-host = 100
        
    chain-threads = 8
    http-threads = 6

    # eosio2.0
    http-max-response-time-ms = 100

    #wasm-runtime = wabt
    #Only!! for performance eosio 2.0+
    eos-vm-oc-compile-threads = 4
    eos-vm-oc-enable = 0
    #END
    http-validate-host = false
    verbose-http-errors = true
    abi-serializer-max-time-ms = 2000
    enable-account-queries = true #only for API node
            



    access-control-allow-origin = *
    access-control-allow-headers = Origin, X-Requested-With, Content-Type, Accept
    # access-control-max-age =
    # access-control-allow-credentials = false


    # actor-whitelist =
    # actor-blacklist =
    # contract-whitelist =
    # contract-blacklist =
    # filter-on =


    # SSL
    # Filename with https private key in PEM format. Required for https (eosio::http_plugin)
    # https-server-address =
    # Filename with the certificate chain to present on https connections. PEM format. Required for https. (eosio::http_plugin)
    # https-certificate-chain-file =
    # Filename with https private key in PEM format. Required for https (eosio::http_plugin)
    # https-private-key-file =


    # State History (For 1.8.0-rc1+ add to start params --disable-replay-opts )
    # plugin = eosio::state_history_plugin
    # state-history-dir = state-history
    # trace-history = true
    # chain-state-history = true
    # state-history-endpoint = 0.0.0.0:8080
    # debug mode info (https://github.com/EOSIO/eos/pull/7298)
    # #trace-history-debug-mode
    
    # allowed-connection = specified
    # peer-private-key = ["!!NEW_KEY_PUB!!","!!NEW_KEY_PRIV!!"] #create new key for private peers
    # peer-key = "!![PUBKEY]!!" 
   
   
    max-clients = 150
    #network-version-match = 0
    sync-fetch-span = 2000
    

    #mongodb-queue-size = 256
    # mongodb-uri =

    # peer-key =
    # peer-private-key =

    plugin = eosio::producer_plugin
    #plugin = eosio::producer_api_plugin
    plugin = eosio::chain_plugin
    plugin = eosio::chain_api_plugin
    


# Peers as of 2026-10-14 (all reachable). The current list: https://monitor4.jungletestnet.io/#p2p
p2p-peer-address = jungle4.cryptolions.io:9870
p2p-peer-address = peer.jungle4.alohaeos.com:9876
p2p-peer-address = jungle4.eosphere.io:9876
p2p-peer-address = jungle4.seed.eosnation.io:9876
p2p-peer-address = p2p.jungle.detroitledger.tech:1337
p2p-peer-address = jungletestnet.eos3.app:9877
p2p-peer-address = 148.113.20.240:9877
p2p-peer-address = 64.204.204.158:9876
p2p-peer-address = jungletestnet.eospanshi.com:9876
